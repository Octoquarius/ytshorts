# ── Anthropic (Claude) ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_IDEA_MODEL=claude-haiku-4-5
CLAUDE_PROMPT_MODEL=claude-opus-4-8

# ── Wavespeed AI (Seedance text-to-video) ────────────────────────
WAVESPEED_API_KEY=

# ── Fal AI (mmaudio sound + ffmpeg editing) ──────────────────────
FAL_API_KEY=

# ── Google Sheets ────────────────────────────────────────────────
# ID of the single Google Sheet where all accounts are logged
GOOGLE_SHEET_ID=
# Path to the OAuth client_secret for the Sheets API (a single project is enough)
SHEETS_CLIENT_SECRET=credentials/sheets/client_secret.json
SHEETS_TOKEN=credentials/sheets/token.json

# ── Gmail notification (App Password) ─────────────────────────────
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
NOTIFY_TO=

# ── General ─────────────────────────────────────────────────────
# Poll interval in seconds (Wavespeed/Fal polling)
POLL_INTERVAL=10
# Maximum wait for polling (seconds)
POLL_TIMEOUT=600
