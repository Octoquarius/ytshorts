# ── Anthropic (Claude) ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_IDEA_MODEL=claude-haiku-4-5
CLAUDE_PROMPT_MODEL=claude-opus-4-8

# ── Wavespeed AI (Seedance text-to-video) ────────────────────────
WAVESPEED_API_KEY=

# ── Fal AI (mmaudio ses + ffmpeg kurgu) ──────────────────────────
FAL_API_KEY=

# ── Google Sheets ────────────────────────────────────────────────
# Tüm hesapların loglandığı tek Google Sheet'in kimliği
GOOGLE_SHEET_ID=
# Sheets API için OAuth client_secret yolu (tek proje yeterli)
SHEETS_CLIENT_SECRET=credentials/sheets/client_secret.json
SHEETS_TOKEN=credentials/sheets/token.json

# ── Gmail bildirimi (App Password) ───────────────────────────────
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
NOTIFY_TO=

# ── Genel ────────────────────────────────────────────────────────
# Saniye cinsinden poll aralığı (Wavespeed/Fal sorgulama)
POLL_INTERVAL=10
# Poll için maksimum bekleme (saniye)
POLL_TIMEOUT=600
